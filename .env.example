# ======================================
# PROGRAM DISCOVERY AGENT - CONFIGURATION
# ======================================

# -------- Database (MySQL) --------
DB_HOST=localhost
DB_NAME=ouroboros_program_db
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_PORT=3306

DB_POOL_SIZE=10
DB_POOL_NAME=program_discovery_pool
DB_CONNECTION_TIMEOUT=20

# Docker MySQL port (host-side, avoids collision with other agents)
DOCKER_MYSQL_PORT=3309

# -------- Inter-Service Authentication (Internal JWT) --------
INTERNAL_TOKEN_VERIFY_ENABLED=true
INTERNAL_TOKEN_SIGNING_ALGORITHM=RS256
INTERNAL_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
INTERNAL_TOKEN_PUBLIC_KEYS={}
INTERNAL_TOKEN_JWKS_URL=http://ouroboros-ai-orchestrator:8000/internal/.well-known/jwks.json
INTERNAL_TOKEN_JWKS_REFRESH_SECONDS=60
INTERNAL_TOKEN_JWKS_TIMEOUT_SECONDS=2
INTERNAL_TOKEN_AUDIENCE=ouroboros.program-discovery
INTERNAL_TOKEN_ISSUER=ouroboros-orchestrator-internal

# -------- LLM Configuration --------
# Primary: OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.0

# Fallback: Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=2000

# Retry settings
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2

# -------- Ranking Weights (must sum to 100) --------
RANKING_WEIGHT_FIELD_RELEVANCE=40
RANKING_WEIGHT_REQUIREMENT_MATCH=25
RANKING_WEIGHT_UNIVERSITY_RANKING=15
RANKING_WEIGHT_DEADLINE_PROXIMITY=10
RANKING_WEIGHT_TUITION_AFFORDABILITY=10

# -------- Crawling Configuration --------
CRAWL_RESPECT_ROBOTS_TXT=true
CRAWL_RATE_LIMIT_DELAY=2.0
CRAWL_USER_AGENT=OuroborosCrawler/1.0 (+https://ouroboros.ai/crawler)
CRAWL_TIMEOUT_SECONDS=30
CRAWL_STALE_DAYS=30

# -------- Application --------
LOG_LEVEL=INFO
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8002
USE_MOCK_DATA=false
ALLOW_DB_FAILURE=false
